<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.HelloController"
            prefHeight="400.0" prefWidth="400.0"
            stylesheets="@style.css">

    <VBox layoutX="10.0" layoutY="10.0" prefWidth="400.0" spacing="10"
          AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="210.0" AnchorPane.topAnchor="10.0">

        <Label text="Chat Area" />

        <ListView fx:id="messageView"
                  prefHeight="300.0" VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" prefHeight="60.0">
            <TextArea fx:id="messageField" promptText="Enter your message" wrapText="true"
                      prefHeight="60.0" maxWidth="350.0"
                      HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" text="Send" prefHeight="20.0" prefWidth="60.0"
                    onAction="#sendMessage" />
        </HBox>




    </VBox>
</AnchorPane>

